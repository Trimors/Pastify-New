# Postgres connection string
DATABASE_URL="postgresql://pastify:pastify@localhost:5432/pastify?schema=public"

# Long random string (openssl rand -hex 32). Signs unlock grants and hashes visitors.
AUTH_SECRET="change-me"

# Public site URL, used in links, API docs and link previews
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Pastify"

# Sponsor/offer link shown in the unlock "sponsor" step.
# Replace with your ad / offer network smartlink (e.g. AdMaven).
SPONSOR_URL="https://example.com/sponsor"

# Optional Cloudflare Turnstile. When both are set, unlock flows require it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Email of the first admin. That account gets the ADMIN role on signup / seed.
ADMIN_EMAIL="admin@example.com"

# Optional display-ad tag script loaded in the unlock "Quick check" step.
NEXT_PUBLIC_AD_SCRIPT_URL=""

# Which request header holds the visitor's real IP. Use the one your host/proxy sets:
# Cloudflare: cf-connecting-ip · Vercel / most proxies: x-forwarded-for · nginx: x-real-ip
IP_HEADER="x-forwarded-for"

# Which header holds the visitor's country code. Needed for country rates; unset = everyone is "rest of world".
# Cloudflare: cf-ipcountry · Vercel: x-vercel-ip-country
GEO_HEADER=""

# Secret for the daily cleanup job (/api/cron/cleanup). openssl rand -hex 24
CRON_SECRET=""

# ── Premium (Paddle Billing) ─────────────────────────────────────────────
# "sandbox" while testing, "production" when live.
NEXT_PUBLIC_PADDLE_ENV="sandbox"
# Paddle → Developer tools → Authentication → client-side token (safe to expose).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Paddle → Developer tools → Authentication → API key (secret; used for the cancel/manage portal).
PADDLE_API_KEY=""
# Paddle → Developer tools → Notifications → your destination's secret key.
PADDLE_WEBHOOK_SECRET=""
# Price ids (pri_…) for the three plans. Prices in Paddle must match src/lib/premium.ts.
PADDLE_PRICE_MONTHLY=""
PADDLE_PRICE_QUARTERLY=""
PADDLE_PRICE_YEARLY=""
