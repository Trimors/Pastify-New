# Postgres connection string
DATABASE_URL="postgresql://pastify:pastify@localhost:5432/pastify?schema=public"

# Long random string (openssl rand -hex 32). Signs unlock grants and hashes visitors.
AUTH_SECRET="change-me"

# Public site URL, used in links, API docs and link previews
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Pastify"

# Sponsor/offer link shown in the unlock "sponsor" step.
# Replace with your ad / offer network smartlink (e.g. AdMaven).
SPONSOR_URL="https://example.com/sponsor"

# Optional Cloudflare Turnstile. When both are set, unlock flows require it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Email of the first admin. That account gets the ADMIN role on signup / seed.
ADMIN_EMAIL="admin@example.com"

# Optional display-ad tag script loaded in the unlock "Quick check" step.
NEXT_PUBLIC_AD_SCRIPT_URL=""
